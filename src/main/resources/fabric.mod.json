{
	"schemaVersion": 1,
	"id": "relignite",
	"version": "${version}",
	"name": "Relignite - Model Definition Backport",
	"description": "Backports the items model definition system added in 1.21.4; Beta version, doesn't include everything and still uses Pommel icon.",
	"authors": [
		"TimmyChips"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/pommel-held-item-models",
		"issues": "https://github.com/TimmyChips/Pommel-Held-Item-Models",
		"sources": "https://github.com/TimmyChips/Pommel-Held-Item-Models"
	},
	"license": "MIT",
	"icon": "assets/pommel/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"timmychips.relignitemodeldefinitions.ServerInitializer"
		],
		"client": [
			"timmychips.relignitemodeldefinitions.ClientInitializer"
		]
	},
	"mixins": [
      "relignite.mixins.json",
		{
			"config": "relignite.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": ">=0.116.0+1.21.1"
	},
	"suggests": {
		"another-mod": "*"
	}
}